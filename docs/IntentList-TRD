## 6. Core Business Logic — Service Layer

### 6.1 Mood Matching Service

```typescript
type MoodState = 'focused' | 'low_energy' | 'between_things' | 'creative' | 'quick_clear';

const MOOD_COMPATIBILITY: Record<MoodState, string[]> = {
  focused:         ['focused', 'any'],
  low_energy:      ['low_energy', 'quick_clear', 'any'],
  between_things:  ['between_things', 'quick_clear', 'any'],
  creative:        ['creative', 'focused', 'any'],
  quick_clear:     ['quick_clear', 'low_energy', 'any'],
};

const MOOD_MAX_DURATION: Record<MoodState, number | null> = {
  focused:         null,
  low_energy:      30,
  between_things:  30,
  creative:        null,
  quick_clear:     15,
};

function getTasksForMood(allActiveTasks: Task[], mood: MoodState, limit: number = 6): Task[] {
  const compatibleMoods = MOOD_COMPATIBILITY[mood];
  const maxDuration = MOOD_MAX_DURATION[mood];

  return allActiveTasks
    .filter(task => {
      const moodMatch = compatibleMoods.includes(task.required_mood ?? 'any');
      const durationMatch = maxDuration === null || (task.estimated_duration ?? 0) <= maxDuration;
      return moodMatch && durationMatch;
    })
    .sort((a, b) => {
      if (b.friction_score !== a.friction_score) {
        return b.friction_score - a.friction_score;
      }
      return a.sort_order - b.sort_order;
    })
    .slice(0, limit);
}
```

### 6.2 Friction Score Service

```typescript
const FRICTION_WEIGHTS = {
  SCROLL_PAST: 1,
  SNOOZE: 2,
  DUE_DATE_MOVE: 3,
  SESSION_NO_INTERACT: 1,
};

const FRICTION_INTERVENTION_THRESHOLD = 8;

async function recordFrictionEvent(taskId: string, eventType: string): Promise<void> {
  const weight = FRICTION_WEIGHTS[eventType];
  
  await db.run(`
    UPDATE tasks 
    SET friction_score = friction_score + ?, updated_at = ?
    WHERE id = ?
  `, [weight, Date.now(), taskId]);
}

async function getTaskForIntervention(userId: string): Promise<Task | null> {
  return db.get(`
    SELECT * FROM tasks
    WHERE user_id = ? AND status = 'active' AND friction_score >= ?
    ORDER BY friction_score DESC LIMIT 1
  `, [userId, FRICTION_INTERVENTION_THRESHOLD]);
}
```

### 6.3 Task Cap Enforcement Service

```typescript
const ACTIVE_TASK_LIMIT = 15;

async function canAddActiveTask(userId: string): Promise<boolean> {
  const result = await db.get(
    `SELECT COUNT(*) as count FROM tasks WHERE user_id = ? AND status = 'active'`,
    [userId]
  );
  return result.count < ACTIVE_TASK_LIMIT;
}

async function addTaskWithCapCheck(userId: string, taskData: any) {
  const canAdd = await canAddActiveTask(userId);
  
  if (!canAdd) {
    const candidates = await db.all(`
      SELECT * FROM tasks
      WHERE user_id = ? AND status = 'active'
      ORDER BY friction_score DESC, created_at ASC LIMIT 3
    `, [userId]);
    return { success: false, needsResolution: true, candidates };
  }
  
  return { success: true };
}
```

### 6.4 Sunday Reckoning Service

```typescript
const RECKONING_CRITERIA = {
  MIN_TIMES_MOVED: 2,
  MIN_TIMES_SNOOZED: 2,
  UNTOUCHED_DAYS: 7,
};

async function getReckoningTasks(userId: string): Promise<Task[]> {
  const sevenDaysAgo = Date.now() - (7 * 24 * 60 * 60 * 1000);
  
  return db.all(`
    SELECT * FROM tasks
    WHERE user_id = ? AND status = 'active'
    AND (times_due_date_moved >= ? OR times_snoozed >= ? OR updated_at < ?)
    ORDER BY friction_score DESC
  `, [userId, RECKONING_CRITERIA.MIN_TIMES_MOVED, RECKONING_CRITERIA.MIN_TIMES_SNOOZED, sevenDaysAgo]);
}
```

