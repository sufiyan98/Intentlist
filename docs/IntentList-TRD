CREATE TABLE users (
  id TEXT PRIMARY KEY,
  name TEXT NOT NULL,
  email TEXT NOT NULL,
  created_at INTEGER NOT NULL,
  preferences TEXT NOT NULL
);

-- Tasks table
CREATE TABLE tasks (
  id TEXT PRIMARY KEY,
  user_id TEXT NOT NULL,
  title TEXT NOT NULL,
  notes TEXT,
  status TEXT NOT NULL DEFAULT 'active',
  required_mood TEXT,
  estimated_duration INTEGER,
  person_tag TEXT,
  location_tag TEXT,
  location_lat REAL,
  location_lng REAL,
  location_radius_meters INTEGER DEFAULT 200,
  due_date INTEGER,
  completed_at INTEGER,
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL,
  sort_order INTEGER NOT NULL,
  friction_score INTEGER DEFAULT 0,
  friction_intervened_at INTEGER,
  times_snoozed INTEGER DEFAULT 0,
  times_due_date_moved INTEGER DEFAULT 0,
  times_scrolled_past INTEGER DEFAULT 0,
  is_synced INTEGER DEFAULT 0,
  server_updated_at INTEGER,
  FOREIGN KEY (user_id) REFERENCES users(id)
);

-- Sub-tasks table
