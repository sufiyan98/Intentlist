# ===========================================
# Phase 3+: Calendar Integration (Optional)
# ===========================================
# Google Calendar OAuth Client ID for calendar integration

# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ===========================================
# Phase 3+: Location Services (Optional)
# ===========================================
# Geofencing is handled via expo-location, no API key needed for basic usage

# ===========================================
# Analytics (Optional - PostHog self-hosted)
# ===========================================
# POSTHOG_API_KEY=your-posthog-api-key
# POSTHOG_HOST=https://your-posthog-instance.com

# ===========================================
# Error Monitoring (Optional - Sentry)
# ===========================================
# SENTRY_DSN=https://your-sentry-dsn

# ===========================================
# App Configuration
# ===========================================
# Environment mode (development, staging, production)
APP_ENV=development

# Enable debug logging (true/false)
DEBUG=false
